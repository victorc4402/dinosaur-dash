using UnityEngine;
using System.Collections.Generic;

[RequireComponent(typeof(AudioSource))] 
public class AudioManager : MonoBehaviour
{
    public static AudioManager Instance { get; private set; }

    [System.Serializable]
    public class Sound
    {
        public string name;
        public AudioClip[] clips; 
    }

    public List<Sound> sounds = new List<Sound>();
    
    private AudioSource sfxSource;
    private AudioSource musicSource;

    // Playlist variables
    private List<AudioClip> musicPlaylist = new List<AudioClip>();
    private int currentTrackIndex = 0;
    private bool isPlaylistActive = false;

    void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else
        {
            Destroy(gameObject);
            return;
        }

        sfxSource = GetComponent<AudioSource>();
        musicSource = gameObject.AddComponent<AudioSource>();
        musicSource.loop = false; // IMPORTANT: Set to false so Update can detect the end of the song
    }

    void Update()
    {
        // If a playlist is active and the music stops playing naturally
        if (isPlaylistActive && !musicSource.isPlaying)
        {
            PlayNextTrack();
        }
    }

    public void PlaySound(string soundName)
    {
        Sound s = sounds.Find(sound => sound.name == soundName);
        if (s == null || s.clips.Length == 0) return;

        int randomIndex = Random.Range(0, s.clips.Length);
        sfxSource.PlayOneShot(s.clips[randomIndex]);
    }

    public void PlayMusic(string musicName)
    {
        Sound m = sounds.Find(sound => sound.name == musicName);
        if (m == null || m.clips.Length == 0) return;

        // 1. Create a fresh playlist from the clips provided in the Inspector
        musicPlaylist.Clear();
        musicPlaylist.AddRange(m.clips);

        // 2. Shuffle the playlist
        ShufflePlaylist();

        // 3. Start from the first track
        currentTrackIndex = 0;
        isPlaylistActive = true;
        
        PlayTrackAtIndex();
    }

    private void PlayNextTrack()
    {
        currentTrackIndex++;

        // If we reached the end of the list, reshuffle and start over
        if (currentTrackIndex >= musicPlaylist.Count)
        {
            ShufflePlaylist();
            currentTrackIndex = 0;
        }

        PlayTrackAtIndex();
    }

    private void PlayTrackAtIndex()
    {
        musicSource.clip = musicPlaylist[currentTrackIndex];
        musicSource.Play();
    }

    private void ShufflePlaylist()
    {
        // Fisher-Yates Shuffle: a standard way to randomly reorder a list
        for (int i = 0; i < musicPlaylist.Count; i++)
        {
            int randomIndex = Random.Range(i, musicPlaylist.Count);
            AudioClip temp = musicPlaylist[i];
            musicPlaylist[i] = musicPlaylist[randomIndex];
            musicPlaylist[randomIndex] = temp;
        }
    }
}